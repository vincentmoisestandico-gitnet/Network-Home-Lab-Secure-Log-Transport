flush ruleset
table inet isp {
  chain input   { type filter hook input priority 0; policy drop; }
  chain forward {
    type filter hook forward priority 0; policy drop;
    iifname "eth1" oifname "eth2" ip saddr 203.0.113.2 ip daddr 203.0.113.6 udp sport 51820 udp dport 51820 accept
    iifname "eth2" oifname "eth1" ip saddr 203.0.113.6 ip daddr 203.0.113.2 udp sport 51820 udp dport 51820 accept
  }
}
